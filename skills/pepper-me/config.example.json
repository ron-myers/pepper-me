{
  "default_heat": "medium",
  "tone": "direct",
  "questions_per_round": 4,
  "ask_what_i_missed": true,

  "other_sessions": {
    "enabled": false,
    "lookback_hours": 24,
    "max_sessions": 10,
    "only_projects": [],
    "skip_projects": [],
    "include_past_chats": true
  },

  "conflict_check": {
    "enabled": true,
    "sources": ["this_session", "other_sessions", "memory", "repo"],
    "repo_files": ["README.md", "CLAUDE.md", "AGENTS.md", "docs/", ".pepper/brief.md"],
    "ask_on": "hard",
    "log_soft": true
  },

  "brief": {
    "size": "auto",
    "save": true,
    "path": ".pepper/brief.md",
    "template": null,
    "versioning": true
  }
}
