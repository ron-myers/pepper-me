{
  "preset": null,
  "default_heat": "medium",
  "default_rigor": "firm",
  "tone": "direct",
  "questions_per_round": 4,
  "max_questions": null,
  "answer_style": "choice",
  "recommend": "always",
  "research": "light",
  "reflect": "start",
  "ask_what_i_missed": "end",
  "show_progress": true,

  "other_sessions": {
    "enabled": false,
    "lookback_hours": 24,
    "max_sessions": 10,
    "only_projects": [],
    "skip_projects": [],
    "include_past_chats": true
  },

  "conflict_check": {
    "enabled": true,
    "ask_on": "hard",
    "log_soft": true
  },

  "init": {
    "path": "PROJECT.md",
    "scan": true,
    "link_agent_files": "ask",
    "agent_files": ["CLAUDE.md", "AGENTS.md"]
  }
}
